# Database connection for the history tables (rainfall, river level, forecast,
# prediction and risk-result logs).
#
# Leave DATABASE_URL unset to use the SQLite default defined in
# app/db/session.py -- no driver or server needed.
#
# To run against the MySQL service in docker-compose.yml, start it with the
# "mysql" profile and export a URL in this shape:
#
#   DATABASE_URL=mysql+pymysql://flood_user:flood_pass@mysql/flood_risk
#
# Use your own credentials; the values above match the local Compose service
# only and are not meant for any deployed database.
# DATABASE_URL=
